# 3. دوال جلب البيانات وحساب المؤشرات الفنية
@st.cache_data(ttl=900)  # تحديث الكاش كل 15 دقيقة
def fetch_stock_data(ticker, period="6mo"):
    try:
        df = yf.download(ticker, period=period, interval="1d", progress=False)
        if df.empty:
            return None
        # معالجة الأعمدة متعددة المستويات في الإصدارات الحديثة من yfinance
        if isinstance(df.columns, pd.MultiIndex):
            df.columns = df.columns.get_level_values(0)
        return df.dropna()
    except Exception:
        return None

def calculate_indicators(df):
    data = df.copy()
    
    # المتوسطات المتحركة (SMA 20 & SMA 50)
    data['SMA20'] = data['Close'].rolling(window=20).mean()
    data['SMA50'] = data['Close'].rolling(window=50).mean()
    
    # مؤشر القوة النسبية (RSI 14)
    delta = data['Close'].diff()
    gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()
    loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()
    rs = gain / loss.replace(0, np.nan)
    data['RSI'] = 100 - (100 / (1 + rs))
    
    # مؤشر الـ MACD
    ema12 = data['Close'].ewm(span=12, adjust=False).mean()
    ema26 = data['Close'].ewm(span=26, adjust=False).mean()
    data['MACD'] = ema12 - ema26
    data['Signal_Line'] = data['MACD'].ewm(span=9, adjust=False).mean()
    
    # متوسط المدى الحقيقي (ATR) لحساب وقف الخسارة
    high_low = data['High'] - data['Low']
    high_close = np.abs(data['High'] - data['Close'].shift())
    low_close = np.abs(data['Low'] - data['Close'].shift())
    tr = pd.concat([high_low, high_close, low_close], axis=1).max(axis=1)
    data['ATR'] = tr.rolling(window=14).mean()
    
    return data

# 4. محرك التوصيات الذكي (Buy / Sell Decision Engine)
def generate_recommendation(df):
    if df is None or len(df) < 50:
        return "بيانات غير كافية", "⚪", 0, [], 0, 0

    latest = df.iloc[-1]
    prev = df.iloc[-2]
    
    score = 0
    reasons = []
    
    # 1. تحليل RSI
    if latest['RSI'] < 30:
        score += 2
        reasons.append(f"🟢 مؤشر RSI في منطقة تشبع بيعي قوية ({latest['RSI']:.1f}) مما يدعم الارتداد الصاعد.")
    elif latest['RSI'] < 45 and latest['RSI'] > prev['RSI']:
        score += 1
        reasons.append(f"🟢 مؤشر RSI يرتد لأعلى من منطقة منخفضة ({latest['RSI']:.1f}).")
    elif latest['RSI'] > 70:
        score -= 2
        reasons.append(f"🔴 مؤشر RSI في منطقة تشبع شرائي ({latest['RSI']:.1f}) - احذر من جني الأرباح.")

    # 2. تحليل المتوسطات المتحركة (الاتجاه)
    if latest['Close'] > latest['SMA20'] and latest['SMA20'] > latest['SMA50']:
        score += 2
        reasons.append("🟢 السعر يتحرك في اتجاه صاعد واضح أعلى من متوسطي 20 و 50 يوم.")
    elif latest['Close'] > latest['SMA20']:
        score += 1
        reasons.append("🟢 السعر أعلى من المتوسط المتحرك 20 يوم (إيجابي على المدى القصير).")
    elif latest['Close'] < latest['SMA20'] and latest['SMA20'] < latest['SMA50']:
        score -= 2
        reasons.append("🔴 السعر في مسار هابط تحت متوسطي 20 و 50 يوم.")

    # 3. تحليل MACD (الزخم)
    if latest['MACD'] > latest['Signal_Line'] and prev['MACD'] <= prev['Signal_Line']:
        score += 2
        reasons.append("🟢 تقاطع إيجابي حديث (شرائي) على مؤشر MACD.")
    elif latest['MACD'] > latest['Signal_Line']:
        score += 1
        reasons.append("🟢 زخم إيجابي مستمر على مؤشر MACD.")
    elif latest['MACD'] < latest['Signal_Line'] and prev['MACD'] >= prev['Signal_Line']:
        score -= 2
        reasons.append("🔴 تقاطع سلبي حديث (بيعي) على مؤشر MACD.")
    else:
        score -= 1
        reasons.append("🔴 زخم سلبي على مؤشر MACD.")

    # تحديد القرار النهائي
    if score >= 3:
        decision, badge = "شراء قوي (Strong Buy)", "🟢🟢"
    elif score >= 1:
        decision, badge = "شراء (Buy)", "🟢"
    elif score == 0:
        decision, badge = "احتفاظ / مراقبة (Hold)", "🟡"
    elif score >= -2:
        decision, badge = "بيع / تخفيف (Sell)", "🔴"
    else:
        decision, badge = "بيع قوي (Strong Sell)", "🔴🔴"

    # حساب مستويات وقف الخسارة وجني الأرباح باستخدام ATR
    atr = latest['ATR'] if not np.isnan(latest['ATR']) else latest['Close'] * 0.03
    stop_loss = latest['Close'] - (1.5 * atr)
    take_profit = latest['Close'] + (3.0 * atr)

    return decision, badge, score, reasons, stop_loss, take_profit

